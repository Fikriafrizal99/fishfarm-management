{
  "name": "fishfarm-management",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:destroy": "docker compose down -v",
    "db:push": "prisma db push",
    "db:constraints": "tsx scripts/apply-db-constraints.ts",
    "db:seed": "prisma db seed",
    "decision:evaluate": "tsx scripts/evaluate-alerts.ts",
    "db:reset": "npm run prisma:generate && prisma db push --force-reset && npm run db:constraints && npm run db:seed && npm run decision:evaluate",
    "db:bootstrap": "npm run db:up && npm run prisma:generate && npm run db:push && npm run db:constraints && npm run db:seed && npm run decision:evaluate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "next": "16.2.11",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
